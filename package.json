{
  "name": "codex-watcher-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "concurrently -k -n be,fe -c cyan,magenta \"pnpm dev:be\" \"pnpm dev:fe\"",
    "dev:fe": "pnpm --filter @watcher/web dev --host 127.0.0.1 --port 5173",
    "dev:be": "bash ./scripts/run-api-dev.sh",
    "dev:web": "pnpm dev:fe",
    "dev:api": "pnpm dev:be",
    "build": "pnpm --filter @watcher/shared-types build && pnpm --filter @watcher/web build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "pnpm --filter @watcher/shared-types test && pnpm --filter @watcher/web test",
    "test:api": "cd apps/api && PYTHONPATH=src pytest -q",
    "test:e2e": "playwright test",
    "test:ios": "pnpm --filter @watcher/ios test",
    "test:ios:unit": "pnpm --filter @watcher/ios test:unit",
    "test:ios:ui": "pnpm --filter @watcher/ios test:ui",
    "test": "pnpm test:unit && pnpm test:api",
    "build:ios": "pnpm --filter @watcher/ios build",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@playwright/test": "^1.52.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.2"
  }
}
